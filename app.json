{
  "expo": {
    "name": "PetSave 派遣系統 Demo",
    "slug": "petsave-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petsave",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petsave.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PetSave 需要存取您的位置，以記錄到場救援的定位打卡資訊。",
        "NSCameraUsageDescription": "PetSave 需要使用您的相機，以拍攝事發地點照、處理中照與三聯單照片。",
        "NSPhotoLibraryUsageDescription": "PetSave 需要存取您的相簿，以便上傳案件相關照片。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.petsave.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "請至 Google Cloud Console 申請 Maps SDK for Android 金鑰後填入這裡"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允許 PetSave 記錄到場救援的定位打卡資訊。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允許 PetSave 使用相機拍攝案件照片。"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89afd84f-3e5b-47de-8ead-2b0536bb05e6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "jerry94714"
  }
}
